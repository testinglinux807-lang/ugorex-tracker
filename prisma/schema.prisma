// Skema database Ugorex Dashboard (tracker funnel AIDA + Loyalty)
// Field "enum" sengaja disimpan sebagai String (nilainya didefinisikan di
// lib/constants.ts) agar portable lintas database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Pengguna aplikasi. role: ADMIN | SALES | OWNER
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique // dipakai untuk login
  passwordHash String
  role         String   @default("SALES")
  createdAt    DateTime @default(now())

  // Untuk OWNER: toko yang dimilikinya
  ownedStore   Store?   @relation("StoreOwnerUser")

  // Toko yang dipegang user ini sebagai sales
  handledStores Store[]    @relation("StoreSales")
  prospects     Prospect[] @relation("ProspectSales")
  stageLogs     StageLog[] @relation("StageLogSales")
  createdSales   Sale[]   @relation("SaleCreator")
  createdTickets Ticket[] @relation("TicketCreator")
  stockAdjustments StockAdjustment[] @relation("StockAdjustmentCreator")

  // Siapa yang membuat akun ini (mis. sales membuat akun owner)
  createdById  String?
  createdBy    User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreator")
  createdRequests Request[] @relation("RequestCreator")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Tugas manual dari admin
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  // Catatan keuangan yang dibuat (admin)
  financeEntries FinanceEntry[] @relation("FinanceCreator")
}

// Langganan Web Push per perangkat/browser (notifikasi order untuk admin/sales)
// Kode voucher diskon — dibuat admin (menu Data), dipakai owner saat
// order restok (/order) dan catat penjualan (/pos).
model Voucher {
  id        String    @id @default(cuid())
  code      String    @unique // disimpan UPPERCASE
  type      String    @default("PERCENT") // PERCENT (persen) | FIXED (Rupiah)
  value     Int // persen 1-100 atau potongan Rupiah
  maxUses   Int? // batas total pemakaian; null = tanpa batas
  usedCount Int       @default(0)
  expiresAt DateTime? // null = tanpa kadaluarsa
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// Riwayat notifikasi in-app per user (inbox lonceng di header) —
// dicatat bersamaan dengan push/WA di notifyOrder.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String? // tujuan saat item diklik, mis. /order
  readAt    DateTime? // null = belum dibaca (badge lonceng)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Konter / toko yang dituju
model Store {
  id         String   @id @default(cuid())
  name       String
  area       String? // wilayah, mis. "Karawang Barat"
  address    String?
  ownerName  String?
  ownerPhone String?
  lat        Float? // koordinat untuk peta
  lng        Float?
  createdAt  DateTime @default(now())

  // Sales penanggung jawab
  salesId String?
  sales   User?   @relation("StoreSales", fields: [salesId], references: [id])

  // Akun owner toko (opsional, dibuat saat owner setuju)
  ownerUserId String? @unique
  ownerUser   User?   @relation("StoreOwnerUser", fields: [ownerUserId], references: [id])

  prospects    Prospect[]
  transactions Sale[]
  tickets      Ticket[]
  requests     Request[]
  tasks        Task[]
}

// Barang yang dijual, mis. Antigores
model Product {
  id          String     @id @default(cuid())
  name        String
  code        String? // kode/ID barang (mis. "AA01") — barang kompatibel berbagi kode
  description String?
  price       Int        @default(0) // harga satuan (Rupiah)
  imageUrl    String? // foto katalog (data URL terkompresi atau URL eksternal)
  centralStock Int       @default(0) // stok di pusat/gudang (di-inject admin)
  createdAt   DateTime   @default(now())
  prospects   Prospect[]
  transactions Sale[]
  requestItems RequestItem[]
}

// Satu barang di satu konter = satu "prospek" yang ditrack lewat funnel
model Prospect {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tahap funnel saat ini: AWARENESS | INTEREST | DESIRE | ACTION | LOYALTY
  stage     String   @default("AWARENESS")

  // Total stok barang yang sudah dikasih sales ke konter ini
  stock     Int      @default(0)

  salesId   String?
  sales     User?    @relation("ProspectSales", fields: [salesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs        StageLog[]
  adjustments StockAdjustment[]

  @@unique([storeId, productId])
}

// Riwayat update tiap tahap funnel
model StageLog {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  stage    String // AWARENESS | INTEREST | DESIRE | ACTION | LOYALTY
  result   String @default("NEUTRAL") // REJECTED | NEUTRAL | POSITIVE
  note     String // catatan (paling penting)
  quantity Int    @default(0) // jumlah/stok terkait

  salesId  String?
  sales    User?    @relation("StageLogSales", fields: [salesId], references: [id])

  createdAt DateTime @default(now())
}

// Transaksi POS (dicatat owner toko)
model Sale {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String // snapshot nama barang
  qty         Int
  price       Int // harga satuan (Rupiah)
  discount    Int      @default(0) // bagian diskon voucher untuk baris ini
  total       Int // qty * price - discount
  createdById String?
  createdBy   User?    @relation("SaleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Tiket keluhan (dibuat owner toko)
model Ticket {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  createdById String?
  createdBy   User?    @relation("TicketCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Koreksi sisa stok oleh owner toko (angka fisik beda dengan catatan).
// before/after = sisa stok (stok drop-an sales dikurangi terjual) saat koreksi.
model StockAdjustment {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  before Int
  after  Int
  note   String?

  createdById String?
  createdBy   User?   @relation("StockAdjustmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Konfigurasi global (misal: target bulanan)
model Config {
  key   String @id
  value String
}

// Pencatatan keuangan manual (admin, menu Keuangan). Buku kas sederhana:
// type INCOME = pemasukan (mis. profit orderan masuk),
// type EXPENSE = pengeluaran (mis. beli barang dari China, ongkir, gaji).
model FinanceEntry {
  id       String   @id @default(cuid())
  type     String // INCOME | EXPENSE
  amount   Int // jumlah Rupiah (selalu positif)
  category String? // kategori bebas, mis. "Beli barang", "Ongkir"
  note     String // keterangan transaksi
  date     DateTime @default(now()) // tanggal transaksi (bisa diatur admin)

  createdById String?
  createdBy   User?   @relation("FinanceCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type, date])
}

// Permintaan dari owner/sales (misal: minta stok, minta dikunjungi)
model Request {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String   @default("PENDING") // PENDING | COMPLETED
  createdById String?
  createdBy   User?    @relation("RequestCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Untuk checkout restok (payment gateway Midtrans Core API)
  total         Int     @default(0) // total belanja produk SETELAH diskon (belum termasuk fee)
  discount      Int     @default(0) // potongan voucher (Rupiah)
  voucherCode   String? // kode voucher yang dipakai
  paymentStatus String  @default("UNPAID") // UNPAID | PAID

  // Metode & instruksi pembayaran (charge Core API, bukan Snap — instruksi
  // dirender sendiri di UI kita, bukan redirect ke halaman Midtrans)
  paymentMethod   String?   // VA_BCA | VA_BNI | VA_BRI | VA_PERMATA | QRIS | GOPAY | CARD | CASH
  paymentFee      Int       @default(0) // biaya layanan flat, 0 untuk CASH
  txnId           String?   // order_id aktual yang dipakai ke Midtrans (beda dari id kalau charge diulang)
  vaNumber        String?   // nomor VA (bank transfer)
  vaBank          String?   // bca | bni | bri | permata
  qrUrl           String?   // URL gambar QR (QRIS/GoPay)
  paymentDeeplink String?   // deeplink app GoPay (mobile)
  paymentExpiry   DateTime? // kedaluwarsa charge saat ini

  // Bukti pengiriman (report sales saat barang sampai ke owner)
  deliveryPhoto String?   // data URL foto barang — disajikan via /api/delivery-photo
  deliveryNote  String?   // keterangan dari sales
  deliveredAt   DateTime? // kapan barang diserahkan
  deliveredBy   String?   // nama pengantar (snapshot, bukan relasi)

  items RequestItem[]
}

// Tugas manual dari admin ke sales — muncul di tab Tugas milik sales
model Task {
  id          String    @id @default(cuid())
  title       String
  note        String? // catatan/detail dari admin
  priority    String    @default("NORMAL") // HIGH | NORMAL
  dueDate     DateTime? // tenggat (opsional)
  status      String    @default("PENDING") // PENDING | DONE
  completedAt DateTime?

  // Sales yang ditugaskan
  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Admin pembuat tugas
  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

  // Konter terkait (opsional)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status])
}

// Barang yang diminta dalam satu request restok (checkout dari owner)
model RequestItem {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  price     Int     @default(0) // snapshot harga satuan saat checkout
}
