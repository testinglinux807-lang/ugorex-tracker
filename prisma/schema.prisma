// Skema database Ugorex Dashboard (tracker funnel AIDA + Loyalty)
// Field "enum" sengaja disimpan sebagai String (nilainya didefinisikan di
// lib/constants.ts) agar portable lintas database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Pengguna aplikasi. role: ADMIN | SALES | OWNER
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique // dipakai untuk login
  passwordHash String
  role         String   @default("SALES")
  createdAt    DateTime @default(now())

  // Komisi affiliator (hanya berarti untuk role SALES): persen dari omzet
  // konter yang dia pegang, di-set admin di halaman detail sales. 0 = tanpa
  // komisi. Komisi dihitung on-the-fly dari Sale, tidak disnapshot.
  commissionPct Float @default(0)

  // Level 5 "Sales Captain" (rahasia, diangkat admin di detail sales):
  // kepala sales untuk satu wilayah, mis. "Karawang Barat". null = level
  // mengikuti grade huruf (lib/sales-grade.ts salesLevel). Terbatas —
  // satu wilayah hanya boleh punya satu captain (dicek di actions/users).
  captainArea String?

  // Titik tempat tinggal (role SALES, diisi saat registrasi / edit akun):
  // pusat lingkaran radius kerja 7 km di peta beranda sales.
  homeLat Float?
  homeLng Float?

  // NIK KTP (role SALES, 16 digit) — data administrasi karyawan
  nik String?

  // Gaji pokok bulanan (role GUDANG) — dipakai payroll. 0 = belum diatur.
  basePay Int @default(0)

  // No. rekening bank (role SALES) — teks bebas, mis. "BCA 1234567890 a.n.
  // Budi Santoso". Ditampilkan admin di Payroll biar gampang transfer.
  bankAccount String?

  // Untuk OWNER: toko yang dimilikinya
  ownedStore   Store?   @relation("StoreOwnerUser")

  // Toko yang dipegang user ini sebagai sales
  handledStores Store[]    @relation("StoreSales")
  prospects     Prospect[] @relation("ProspectSales")
  stageLogs     StageLog[] @relation("StageLogSales")
  createdSales   Sale[]   @relation("SaleCreator")
  createdTickets Ticket[] @relation("TicketCreator")
  stockAdjustments StockAdjustment[] @relation("StockAdjustmentCreator")

  // Siapa yang membuat akun ini (mis. sales membuat akun owner)
  createdById  String?
  createdBy    User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreator")
  createdRequests Request[] @relation("RequestCreator")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Tugas manual dari admin
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  // Rating bintang dari owner konter untuk sales ini (menu Performa Sales)
  salesRatings SalesRating[] @relation("SalesRatingTarget")

  // Riwayat skor grade bulanan (untuk rata-rata rolling 3 bulan)
  monthlyScores SalesMonthlyScore[] @relation("SalesMonthlyScore")

  // Payroll gudang (role GUDANG): potongan & sesi lembur
  payrollLogs    PayrollLog[]    @relation("PayrollLogUser")
  lemburSessions LemburSession[] @relation("LemburUser")

  // Pencairan fee bagi hasil yang diterima sales ini (dicatat admin)
  commissionPayouts CommissionPayout[] @relation("CommissionPayoutSales")

  // Bonus KPI bulanan yang sudah dibayar (status "lunas" per bulan)
  kpiBonusPayouts KpiBonusPayout[] @relation("KpiBonusPayoutSales")

  // Status gaji gudang yang sudah ditandai dicairkan (per bulan)
  gudangSalaryPayouts GudangSalaryPayout[] @relation("GudangSalaryPayoutUser")

  // Catatan keuangan yang dibuat (admin)
  financeEntries FinanceEntry[] @relation("FinanceCreator")

  // Ganti no HP via OTP WA (menu akun di header): nomor baru disimpan dulu
  // di sini sampai kode 6 digit (hash bcrypt) diverifikasi. Attempts dibatasi
  // 5x salah, kirim ulang minimal berjarak 60 detik (otpSentAt).
  pendingPhone String?
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  otpSentAt    DateTime?
}

// Pencairan fee bagi hasil (komisi) sales — dicatat admin di detail sales.
// Saldo "belum dicairkan" sales = total fee dari order lunas − total
// pencairan di sini. Tiap pencairan otomatis jadi pengeluaran buku kas
// (FinanceEntry kategori "Komisi sales", sourceId = id pencairan → terkunci,
// ikut terhapus kalau pencairannya dihapus).
model CommissionPayout {
  id          String   @id @default(cuid())
  salesId     String
  sales       User     @relation("CommissionPayoutSales", fields: [salesId], references: [id], onDelete: Cascade)
  amount      Int
  note        String?
  createdById String? // admin pencatat (snapshot id, tanpa relasi)
  createdAt   DateTime @default(now())
}

// Status pembayaran bonus KPI sales per bulan. Ada baris = bonus bulan itu
// sudah "lunas" (dibayar admin). Tiap penandaan otomatis jadi pengeluaran
// buku kas (FinanceEntry kategori "Bonus KPI Sales", sourceId = id baris →
// terkunci, ikut terhapus kalau statusnya dibatalkan).
model KpiBonusPayout {
  id          String   @id @default(cuid())
  salesId     String
  sales       User     @relation("KpiBonusPayoutSales", fields: [salesId], references: [id], onDelete: Cascade)
  period      String // "YYYY-MM" (WIB)
  amount      Int
  createdById String? // admin pencatat (snapshot id, tanpa relasi)
  createdAt   DateTime @default(now())

  @@unique([salesId, period])
  @@index([salesId, period])
}

// Status pembayaran gaji gudang per bulan — murni PENANDA + pemicu
// notifikasi ke karyawan. TIDAK dobel-catat ke buku kas (gaji gudang sudah
// otomatis tersinkron via syncGudangSalary tiap payroll dibuka).
model GudangSalaryPayout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("GudangSalaryPayoutUser", fields: [userId], references: [id], onDelete: Cascade)
  period      String // "YYYY-MM" (WIB)
  amount      Int
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, period])
  @@index([userId, period])
}

// Undangan registrasi sales: admin buat link unik /daftar-sales/[token]
// (panel Tambah Sales di /sales), calon sales isi datanya sendiri dari HP
// (nama, no HP, password, NIK, titik rumah via GPS). Sekali pakai,
// kedaluwarsa 7 hari.
model SalesInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  note        String? // label admin, mis. "buat Andi"
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String? // id user sales hasil registrasi
}

// Undangan registrasi gudang: admin buat link unik /daftar-gudang/[token]
// (tab Akun Gudang di /data), calon karyawan isi datanya sendiri dari HP
// (nama, no HP, password, no rekening, titik gudang via GPS). Sekali pakai,
// kedaluwarsa 7 hari. Struktur sama dgn SalesInvite, model terpisah supaya
// query per-role tetap sederhana (tanpa kolom role di tabel invite).
model GudangInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
}

// Langganan Web Push per perangkat/browser (notifikasi order untuk admin/sales)
// Kode voucher diskon — dibuat admin (menu Data), dipakai owner saat
// order restok (/order) dan catat penjualan (/pos).
model Voucher {
  id        String    @id @default(cuid())
  code      String    @unique // disimpan UPPERCASE
  type      String    @default("PERCENT") // PERCENT (persen) | FIXED (Rupiah) | FREE (gratis 1 produk)
  value     Int // persen 1-100 atau potongan Rupiah; diabaikan (0) untuk FREE
  // Produk yang di-scope (opsional untuk PERCENT/FIXED, wajib untuk FREE).
  // productId cuma referensi tampilan admin - pencocokan saat redeem pakai
  // Product.code (barang sekode berbagi harga/stok & "produk perwakilan"
  // beda-beda per toko, lihat app/(app)/order/page.tsx repId), bukan id ini.
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  maxUses   Int? // batas total pemakaian; null = tanpa batas
  usedCount Int       @default(0)
  expiresAt DateTime? // null = tanpa kadaluarsa
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// Aturan diskon grosir order restok (dikelola admin di menu Data, di bawah
// Voucher Toko): total qty satu order mencapai minQty → diskon percent%
// dari subtotal, otomatis tanpa kode. Kalau beberapa tier terpenuhi,
// dipakai tier dengan minQty terbesar. Bisa digabung voucher (voucher
// dihitung dari sisa setelah potongan grosir).
model GrosirTier {
  id        String   @id @default(cuid())
  minQty    Int // minimal total pcs dalam satu order
  percent   Int // diskon persen 1-100
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Riwayat notifikasi in-app per user (inbox lonceng di header) —
// dicatat bersamaan dengan push/WA di notifyOrder.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String? // tujuan saat item diklik, mis. /order
  readAt    DateTime? // null = belum dibaca (badge lonceng)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Konter / toko yang dituju
model Store {
  id         String   @id @default(cuid())
  name       String
  area       String? // wilayah, mis. "Karawang Barat"
  address    String?
  ownerName  String?
  ownerPhone String?
  lat        Float? // koordinat untuk peta
  lng        Float?
  createdAt  DateTime @default(now())

  // Sales penanggung jawab
  salesId String?
  sales   User?   @relation("StoreSales", fields: [salesId], references: [id])

  // Akun owner toko (opsional, dibuat saat owner setuju)
  ownerUserId String? @unique
  ownerUser   User?   @relation("StoreOwnerUser", fields: [ownerUserId], references: [id])

  prospects    Prospect[]
  transactions Sale[]
  tickets      Ticket[]
  requests     Request[]
  tasks        Task[]
  salesRating  SalesRating?
}

// Rating sales dari owner konter (bintang 1-5 + keterangan) — diisi owner
// di halaman POS, tampil di Performa Sales & detail sales (admin). Satu
// konter satu rating (owner bisa mengubahnya kapan saja); salesId = sales
// pemegang konter saat rating terakhir disimpan.
model SalesRating {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  salesId String
  sales   User   @relation("SalesRatingTarget", fields: [salesId], references: [id], onDelete: Cascade)

  stars Int // 1-5
  note  String? // keterangan dari owner (opsional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesId])
}

// Potongan gaji gudang (telat, kasbon, absen) — dicatat admin per karyawan
// (User role GUDANG). Lembur TIDAK di sini; lembur pakai LemburSession
// (clock-in/out oleh karyawan sendiri).
model PayrollLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("PayrollLogUser", fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime // tanggal kejadian (jam 0 WIB)
  type       String // TELAT | KASBON | ABSEN
  amount     Int // Rupiah potongan
  note       String?
  createdById String? // admin pencatat (snapshot id, tanpa relasi)
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

// Sesi lembur gudang — karyawan (User role GUDANG) clock-in (startAt) lalu
// clock-out (endAt). Jam lembur = (endAt − startAt); endAt null = sedang
// berjalan. Upah lembur = jam × tarif global (Config payroll_lembur_tarif).
model LemburSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("LemburUser", fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime  @default(now())
  endAt     DateTime? // null = masih berjalan
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId, startAt])
}

// Snapshot skor grade sales per bulan (0-100). Skor bulan berjalan ditulis
// ulang tiap sales buka beranda (dedup kalau sama); bulan lampau dibaca beku
// untuk rata-rata rolling 3 bulan (lib/sales-kpi-grade.ts + sales-score-history.ts).
model SalesMonthlyScore {
  id        String   @id @default(cuid())
  salesId   String
  sales     User     @relation("SalesMonthlyScore", fields: [salesId], references: [id], onDelete: Cascade)
  period    String // "YYYY-MM" (WIB)
  score     Int // 0-100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesId, period])
  @@index([salesId, period])
}

// Barang yang dijual, mis. Antigores
model Product {
  id          String     @id @default(cuid())
  name        String
  code        String? // kode/ID barang (mis. "AA01") — barang kompatibel berbagi kode
  description String?
  price       Int        @default(0) // harga satuan (Rupiah)
  imageUrl    String? // foto katalog (data URL terkompresi atau URL eksternal)
  centralStock Int       @default(0) // stok di pusat/gudang (di-inject admin)
  createdAt   DateTime   @default(now())
  prospects   Prospect[]
  transactions Sale[]
  requestItems RequestItem[]
  vouchers    Voucher[]
}

// Satu barang di satu konter = satu "prospek" yang ditrack lewat funnel
model Prospect {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tahap funnel saat ini: AWARENESS | CONSIDERATION | CONVERSION | LOYALTY | STAR_SELLER
  stage     String   @default("AWARENESS")

  // Total stok barang yang sudah dikasih sales ke konter ini
  stock     Int      @default(0)

  // Harga jual barang ini yang ditetapkan owner untuk tokonya (Rupiah).
  // null = pakai harga default katalog (Product.price). Dipakai prefill POS.
  price     Int?

  salesId   String?
  sales     User?    @relation("ProspectSales", fields: [salesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs        StageLog[]
  adjustments StockAdjustment[]

  @@unique([storeId, productId])
}

// Riwayat update tiap tahap funnel
model StageLog {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  stage    String // AWARENESS | CONSIDERATION | CONVERSION | LOYALTY | STAR_SELLER
  result   String @default("NEUTRAL") // REJECTED | NEUTRAL | POSITIVE
  note     String // catatan (paling penting)
  quantity Int    @default(0) // jumlah/stok terkait

  salesId  String?
  sales    User?    @relation("StageLogSales", fields: [salesId], references: [id])

  createdAt DateTime @default(now())
}

// Transaksi POS (dicatat owner toko)
model Sale {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String // snapshot nama barang
  qty         Int
  price       Int // harga satuan (Rupiah)
  discount    Int      @default(0) // bagian diskon voucher untuk baris ini
  total       Int // qty * price - discount
  createdById String?
  createdBy   User?    @relation("SaleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Tiket keluhan (dibuat owner toko)
model Ticket {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  createdById String?
  createdBy   User?    @relation("TicketCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Koreksi sisa stok oleh owner toko (angka fisik beda dengan catatan).
// before/after = sisa stok (stok drop-an sales dikurangi terjual) saat koreksi.
model StockAdjustment {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  before Int
  after  Int
  note   String?

  createdById String?
  createdBy   User?   @relation("StockAdjustmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Konfigurasi global (misal: target bulanan)
model Config {
  key   String @id
  value String
}

// Pencatatan keuangan manual (admin, menu Keuangan). Buku kas sederhana:
// type INCOME = pemasukan (mis. profit orderan masuk),
// type EXPENSE = pengeluaran (mis. beli barang dari China, ongkir, gaji).
model FinanceEntry {
  id       String   @id @default(cuid())
  type     String // INCOME | EXPENSE
  amount   Int // jumlah Rupiah (selalu positif)
  category String? // kategori bebas, mis. "Beli barang", "Ongkir"
  note     String // keterangan transaksi
  date     DateTime @default(now()) // tanggal transaksi (bisa diatur admin)

  // Terisi untuk entri OTOMATIS dari order restock yang lunas (id Request).
  // @unique menjamin satu order tercatat sekali; entri ber-sourceId tidak
  // bisa diedit/dihapus manual (lihat lib/finance-sync.ts & actions/finance).
  sourceId String? @unique

  createdById String?
  createdBy   User?   @relation("FinanceCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type, date])
}

// Permintaan dari owner/sales (misal: minta stok, minta dikunjungi)
model Request {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  // Alur status order restok (lihat aksi di app/actions/requests.ts):
  // PENDING (disiapkan gudang) → READY (siap dipickup, klik admin) →
  // SHIPPED (kurir/sales bawa barang) → COMPLETED (diterima) atau
  // RETURNED (toko tolak semua saat serah terima). CANCELLED = batal.
  status      String   @default("PENDING") // PENDING | READY | SHIPPED | COMPLETED | CANCELLED | RETURNED
  createdById String?
  createdBy   User?    @relation("RequestCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Untuk checkout restok (payment gateway Midtrans Core API)
  total          Int     @default(0) // total belanja produk SETELAH diskon (belum termasuk fee)
  discount       Int     @default(0) // potongan voucher (Rupiah)
  grosirDiscount Int     @default(0) // potongan diskon grosir (Rupiah) — lihat GrosirTier
  voucherCodes   String[] @default([]) // kode voucher yang dipakai (maks 3, 1 per jenis)
  paymentStatus String  @default("UNPAID") // UNPAID | PAID

  // Metode & instruksi pembayaran (charge Core API, bukan Snap — instruksi
  // dirender sendiri di UI kita, bukan redirect ke halaman Midtrans)
  paymentMethod   String?   // VA_BCA | VA_BNI | VA_BRI | VA_PERMATA | QRIS | GOPAY | CARD | CASH
  paymentFee      Int       @default(0) // biaya layanan flat, 0 untuk CASH
  txnId           String?   // order_id aktual yang dipakai ke Midtrans (beda dari id kalau charge diulang)
  vaNumber        String?   // nomor VA (bank transfer)
  vaBank          String?   // bca | bni | bri | permata
  qrUrl           String?   // URL gambar QR (QRIS/GoPay)
  paymentDeeplink String?   // deeplink app GoPay (mobile)
  paymentExpiry   DateTime? // kedaluwarsa charge saat ini

  // Balasan sales/admin untuk request bebas (bukan order restok) — pembuat
  // request dapat notifikasi isinya (in-app + WA + push)
  response    String?
  respondedBy String?   // snapshot "Nama (Role)" pembalas
  respondedAt DateTime?

  // Jejak alur gudang → kurir (snapshot "Nama (Role)", bukan relasi)
  readyAt    DateTime? // admin/gudang menandai barang siap dipickup
  readyBy    String?
  pickedUpAt DateTime? // sales (kurir) mengambil barang dari gudang
  pickedUpBy String?

  // Bukti pengiriman (report sales saat barang sampai ke owner)
  deliveryPhoto String?   // data URL foto barang — disajikan via /api/delivery-photo
  deliveryNote  String?   // keterangan dari sales
  deliveredAt   DateTime? // kapan barang diserahkan
  deliveredBy   String?   // nama pengantar (snapshot, bukan relasi)

  // Pengembalian pesanan oleh toko saat serah terima (semua / sebagian).
  // Semua → status RETURNED, total jadi 0; sebagian → status COMPLETED,
  // total dikurangi nilai barang yang ditolak. Nilai retur disimpan di
  // returnedTotal, rincian qty per barang di RequestItem.returnedQty.
  // Barang retur balik ke stok pusat; kalau order sudah dibayar,
  // pengembalian dananya lewat alur refund admin (refundedAt di bawah).
  returnedAt    DateTime?
  returnedBy    String? // snapshot "Nama (Owner)"
  returnReason  String?
  returnedTotal Int       @default(0) // nilai Rupiah barang yang diretur

  // Resi pengiriman (label cetak ala marketplace) — dibuat sekali saat
  // admin/sales pertama klik Cetak Resi di /order
  resiNo     String? @unique // nomor resi, mis. UGX260716123456
  pickupCode String? // kode penjemputan — ditunjukkan sales penjemput barang

  // Reservasi stok & pembatalan. stockReserved = stok pusat sudah dipotong
  // saat checkout (skema sejak 16 Jul 2026, anti rebutan stok); order yang
  // dibuat sebelum itu false (stok baru dipotong saat COMPLETED, skema lama).
  // Saat dibatalkan, stok reservasi dikembalikan & flag di-nol-kan atomik.
  stockReserved Boolean   @default(false)
  cancelledAt   DateTime?
  cancelledBy   String? // snapshot "Nama (Role)" / "Sistem" (sweep otomatis)
  cancelReason  String?

  // Pengembalian dana order batal yang terlanjur dibayar — refund uangnya
  // manual di luar app (dashboard Midtrans / transfer / tunai), admin
  // menandainya di sini supaya owner tahu dananya sudah balik.
  refundedAt DateTime?
  refundedBy String? // snapshot "Nama (Admin)"
  refundNote String? // cara pengembalian, mis. "transfer BCA a.n. owner"

  items RequestItem[]
}

// Tugas manual dari admin ke sales — muncul di tab Tugas milik sales
model Task {
  id          String    @id @default(cuid())
  title       String
  note        String? // catatan/detail dari admin
  priority    String    @default("NORMAL") // HIGH | NORMAL
  dueDate     DateTime? // tenggat (opsional)
  status      String    @default("PENDING") // PENDING | DONE
  completedAt DateTime?

  // Sales yang ditugaskan
  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Admin pembuat tugas
  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

  // Konter terkait (opsional)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status])
}

// Barang yang diminta dalam satu request restok (checkout dari owner)
model RequestItem {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty         Int
  price       Int @default(0) // snapshot harga satuan saat checkout
  returnedQty Int @default(0) // qty yang ditolak toko saat serah terima
}
