# ====== UGOREX DASHBOARD — ENV ======

# --- Lokal (development) pakai SQLite ---
# DATABASE_URL="file:./dev.db"

# --- Produksi (Vercel + Neon Postgres) ---
# Ambil dari Neon dashboard:
#  - DATABASE_URL  = "Pooled connection" (untuk runtime) + ?sslmode=require
#  - DIRECT_URL    = "Direct connection" (untuk prisma db push / migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret untuk JWT sesi login — WAJIB diganti string acak panjang di produksi
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang"
