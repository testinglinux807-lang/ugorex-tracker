# ====== UGOREX DASHBOARD — ENV ======

# --- Lokal (development) pakai SQLite ---
# DATABASE_URL="file:./dev.db"

# --- Produksi (Vercel + Neon Postgres) ---
# Ambil dari Neon dashboard:
#  - DATABASE_URL  = "Pooled connection" (untuk runtime) + ?sslmode=require
#  - DIRECT_URL    = "Direct connection" (untuk prisma db push / migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret untuk JWT sesi login — WAJIB diganti string acak panjang di produksi
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# --- Midtrans Snap (pembayaran order restok) ---
# Ambil dari dashboard.midtrans.com -> Settings -> Access Keys.
# Kosongkan kalau belum dipakai: checkout tetap jalan tanpa pembayaran online.
# Webhook: set Payment Notification URL ke https://<domain>/api/midtrans
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
# Default sandbox; aktifkan dua baris ini saat go-live:
# MIDTRANS_IS_PRODUCTION="true"
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true"

# --- Notifikasi WhatsApp order baru (gateway Fonnte) ---
# Daftar di fonnte.com, hubungkan nomor WA pengirim, salin token device.
# Setiap order restok baru dikirim ke WA sales pemegang toko + semua admin.
# Kosongkan kalau belum dipakai.
FONNTE_TOKEN=""
# Basis URL aplikasi untuk link "Proses: .../order" di pesan (opsional)
APP_URL="https://contoh-domain.vercel.app"

# --- Web Push (notifikasi browser, gratis) ---
# Generate sekali: npx web-push generate-vapid-keys
# Admin/sales mengaktifkan lewat tombol lonceng di header aplikasi.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:email-kamu@contoh.com"
